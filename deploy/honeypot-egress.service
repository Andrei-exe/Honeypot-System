# Applies the egress-firewall.sh rules every time Docker starts (so also after a reboot).
# Install steps: README, "Deploying to a server".
[Unit]
Description=Honeypot: block new outbound connections from exposed containers
# after Docker (only then does the DOCKER-USER chain exist); restarted together with Docker
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/honeypot-egress-firewall
ExecStop=/usr/local/sbin/honeypot-egress-firewall remove

[Install]
WantedBy=multi-user.target
