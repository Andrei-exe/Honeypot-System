# Copiaza fisierul asta ca .env (.env NU se urca pe GitHub) si schimba ce ai nevoie.
# Fara .env, docker-compose.yml foloseste valorile implicite (cele de mai jos).
# Atentie: fara ghilimele si fara spatii in jurul lui "=".

# Parola comuna agent <-> threat-engine: agentul o trimite, receiver.py o verifica.
# Gol = receiver.py primeste de la oricine. Una aleatorie:
#   python -c "import secrets; print(secrets.token_hex(16))"
AGENT_TOKEN=

# Cine poate ajunge la honeypot:
#   127.0.0.1 = doar tu, de pe PC-ul tau
#   0.0.0.0   = oricine ajunge la PC (colegi pe acelasi Wi-Fi/hotspot, sau internetul pe un VPS)
BIND_IP=127.0.0.1

# Porturile honeypot-ului pe PC/VPS. Local: aceleasi ca la `go run .`. Pe VPS: 21, 22, 23, 80.
FTP_PORT=2121
SSH_PORT=2222
TELNET_PORT=2323
HTTP_PORT=8080

# Portul dashboard-ului pe PC (mereu doar pe 127.0.0.1): http://127.0.0.1:8050
DASHBOARD_PORT=8050

# true = alerte si pentru IP-uri private (127.x, 172.x din Docker, 192.168.x) -> necesar la demo local.
INCLUDE_INTERNAL=true

# Unde trimite agentul. Gol = threat-engine din compose (ce vrei aproape mereu).
# Doar daca rulezi receiver.py direct pe PC, fara Docker (doar local: pe server,
# deploy/egress-firewall.sh blocheaza intentionat orice conexiune de la agent spre host):
#   SHIPPER_URL=http://host.docker.internal:8000/api/events
SHIPPER_URL=
