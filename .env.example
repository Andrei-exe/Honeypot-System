# Copy this file to .env (.env is NOT pushed to GitHub) and change what you need.
# Without .env, docker-compose.yml uses the defaults (the values below).
# Note: no quotes and no spaces around "=".

# Shared secret agent <-> threat-engine: the agent sends it, receiver.py checks it.
# Empty = receiver.py accepts events from anyone. Generate a random one with:
#   python -c "import secrets; print(secrets.token_hex(16))"
AGENT_TOKEN=

# Who can reach the honeypot: 127.0.0.1 = only you, from this PC;
# 0.0.0.0 = anyone who can reach the machine (same Wi-Fi/hotspot, or the internet on a VPS).
BIND_IP=127.0.0.1

# Honeypot ports on the PC/VPS. Locally: the same as `go run .`. On a VPS: 21, 22, 23, 80.
FTP_PORT=2121
SSH_PORT=2222
TELNET_PORT=2323
HTTP_PORT=8080

# Dashboard port on the PC (always bound to 127.0.0.1 only): http://127.0.0.1:8050
DASHBOARD_PORT=8050

# true = alerts for private IPs too (127.x, Docker's 172.x, 192.168.x) -> needed for a local demo.
INCLUDE_INTERNAL=true

# Where the agent sends its events. Empty = the threat-engine from compose (almost always what you want).
# Set it only for receiver.py running on the PC without Docker (never on a server: the egress firewall blocks it):
#   SHIPPER_URL=http://host.docker.internal:8000/api/events
SHIPPER_URL=
