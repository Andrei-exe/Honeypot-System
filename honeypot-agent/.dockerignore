# What we do NOT send to Docker when building the image (like .gitignore, but for the build).

# SSH private key from `go run .` - the container generates its own, on the volume
ssh_host_*_key

# events from tests/demos (they contain passwords)
*.jsonl

# binaries from `go build`
honeypot-agent
honeypot-agent.exe

# not needed by the build
Dockerfile
.dockerignore
.gitignore
